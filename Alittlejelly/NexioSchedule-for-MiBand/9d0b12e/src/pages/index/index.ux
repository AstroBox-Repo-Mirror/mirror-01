    padding-top: 10px;
  }

  /* 关于页头部：右侧时钟贴边会被 RW6 的右圆角裁切（实机截图 09:12 被切）。
     左右各加 20px 内边距（叠加返回/时钟自身的 10px margin = 距边 30px，
     与首页 hd-wide 的 30px 内缩对齐）。 */
  .ab-head-wide {
    padding-left: 20px;
    padding-right: 20px;
