{
  "version": 1,
  "shared": {
    "band-pro-base": {
      "watchface": {
        "name": "手环 Pro",
        "previewKey": "-pro"
      },
      "canvas": {
        "background": "transparent"
      },
      "wallpaperTransform": {
        "scale": {
          "default": 1,
          "min": 1,
          "max": 4,
          "step": 0.01
        },
        "rotation": {
          "default": 0,
          "min": -180,
          "max": 180,
          "step": 1
        }
      }
    },
    "band-pro-default": {
      "extends": "band-pro-base",
      "canvas": {
        "width": 336,
        "height": 480
      },
      "frame": {
        "x": 0,
        "y": 0,
        "width": 336,
        "height": 480,
        "radius": 0
      },
      "preview": {
        "radius": 56
      },
      "layers": [
        {
          "id": "photo",
          "name": "壁纸",
          "type": "wallpaper",
          "clip": "frame",
          "opacity": 1,
          "blur": 0,
          "blendMode": {
            "default": "normal",
            "adjustable": true,
            "options": [
              "normal",
              "multiply",
              "screen",
              "overlay",
              "darken",
              "lighten",
              "color-dodge",
              "color-burn",
              "hard-light",
              "soft-light",
              "difference",
              "exclusion",
              "hue",
              "saturation",
              "color",
              "luminosity"
            ]
          }
        }
      ]
    }
  },
  "templates": [
    {
      "watchface": {
        "name": "手环 Pro",
        "previewKey": "-pro"
      },
      "canvas": {
        "background": "transparent",
        "width": 336,
        "height": 480
      },
      "wallpaperTransform": {
        "scale": {
          "default": 1,
          "min": 1,
          "max": 4,
          "step": 0.01
        },
        "rotation": {
          "default": 0,
          "min": -180,
          "max": 180,
          "step": 1
        }
      },
      "frame": {
        "x": 0,
        "y": 0,
        "width": 336,
        "height": 480,
        "radius": 0
      },
      "preview": {
        "radius": 56
      },
      "layers": [],
      "id": "band-pro-default",
      "deviceKey": "band-pro",
      "aliases": []
    }
  ]
}