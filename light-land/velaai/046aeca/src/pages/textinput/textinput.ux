<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="container">
    <text class="time">{{ time }}</text>
    <text class="title">{{ title }}</text>
    <img class="top leftButton" src="/common/back_rect.png" @click="routeBack" />
    <img class="top rightButton" src="/common/check_rect.png" @click="save" />

    <div class="padding"></div>
    <div class="line">
      <div class="input-line">
        <!-- JS 字符窗口：不用 scroll（真机上 scroll 内容变化时会自动夹到最右，光标被钉死、左侧文本被切），
             由 calcWindow 按字体宽度估算可视区，只渲染放得下的字符，光标始终可见 -->
        <div class="input-row">
          <text class="input-text">{{ dispBefore }}</text>
          <text class="cursor">|</text>
          <text class="input-text">{{ dispAfter }}</text>
        </div>
      </div>
    </div>
    <!-- 编辑行：位于输入框与键盘之间，删除/光标左移/光标右移 -->
    <div class="edit-row">
      <img class="editbtn" src="/common/del.png" @click="doEdit('D')" />
      <img class="editbtn" src="/common/kleft.png" @click="doEdit('left')" />
      <img class="editbtn" src="/common/kright.png" @click="doEdit('right')" />
    </div>
    <input-method
      hide="{{ hide }}"
      keyboardtype="{{ keyboardtype }}"
      maxlength="5"
      vibratemode="{{ vibratemode }}"
      screentype="{{ screentype }}"
      @visibility-change="onVisibilityChange"
      @key-down="onKeyDown"
      @delete="onDelete"
      @complete="onComplete"
    ></input-method>
  </div>
</template>

<script>
import router from "@system.router"
import * as settings from "../../common/settings.js"

// 28px bold 字体下单字估算宽度（px）：CJK/全角 ≈ 1em，ASCII 字母 ≈ 0.64em，数字 ≈ 0.6em，标点 ≈ 0.54em
function charW(ch) {
  const code = ch.charCodeAt(0)
  // @ # % 真机渲染接近全角宽，按汉字宽度估算
  if (ch === "@" || ch === "#" || ch === "%") return 30
  if (
    (code >= 0x2e80 && code <= 0x9fff) ||
    (code >= 0x3000 && code <= 0x303f) ||
    (code >= 0xff00 && code <= 0xffef)
  ) {
    return 30
  }
  if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) return 18
  if (code >= 48 && code <= 57) return 17
  return 15
}

export default {
  private: {
    time: "",
    title: "输入",
    before: "",
    after: "",
    hide: false,
    keyboardtype: "QWERTY",
    vibratemode: "short",
    screentype: global.screenShape,
    field: "",
    ret: "chat"
  },

  computed: {
    // 可视区内光标前能放下的部分（保留 before 的尾部）
    dispBefore() {
      return this.calcWindow().b
    },
    // 可视区内光标后能放下的部分（保留 after 的开头）
    dispAfter() {
      return this.calcWindow().a
    }
  },

  onInit() {
    if (this.title) this.title = this.title
    if (this.value) this.before = this.value
    if (this.field) this.field = this.field
    if (this.ret) this.ret = this.ret
  },

  onVisibilityChange(evt) {
    console.log("显示状态变更:" + JSON.stringify(evt))
  },

  onKeyDown(evt) {
    console.log("按下按键:" + JSON.stringify(evt))
  },

  // 删除光标前一个字符（即 before 的最后一个字符），键盘 del 键触发
  onDelete() {
    if (this.before.length <= 0) return
    this.before = this.before.slice(0, this.before.length - 1)
  },

  // 在光标位置插入内容（光标在 before/after 之间 → 追加到 before 末尾），候选选中触发
  onComplete(evt) {
    this.before = this.before + evt.detail.content
  },

  // 输入框内部可视宽度（px）：真实屏宽 × 行宽比例（对齐媒体查询）− 左右内边距
  innerWidth() {
    const sw = (global.screenSize && global.screenSize.width) || 336
    const ratio =
      this.screentype === "circle" ? 0.85 : global.deviceType === "watch" ? 0.75 : 0.83
    return sw * ratio - 24
  },

  // 字符窗口：保证光标可见。after 先取最多 35%，before 从尾部取剩余；
  // before 用剩的预算再让给 after（光标靠左时 after 能显示更多，不会被 35% 卡死）
  calcWindow() {
    const avail = this.innerWidth() - 20 // 总安全余量
    const cursorW = 9 // 光标 "|" 宽度

    let aStr = ""
    let aW = 0
    let ai = 0
    const budgetA = avail * 0.35
    while (ai < this.after.length) {
      const w = charW(this.after.charAt(ai))
      if (aW + w > budgetA) break
      aW += w
      aStr += this.after.charAt(ai)
      ai++
    }

    const budgetB = avail - aW - cursorW
    let bStr = ""
    let bW = 0
    for (let i = this.before.length - 1; i >= 0; i--) {
      const w = charW(this.before.charAt(i))
      if (bW + w > budgetB) break
      bW += w
      bStr = this.before.charAt(i) + bStr
    }

    // 第二轮：before 没用完的空间继续给 after
    let leftover = avail - cursorW - aW - bW
    while (ai < this.after.length) {
      const w = charW(this.after.charAt(ai))
      if (w > leftover) break
      leftover -= w
      aStr += this.after.charAt(ai)
      ai++
    }

    return { b: bStr, a: aStr }
  },

  // 编辑行按钮：页面内直接操作 before/after，不经键盘组件中转（真机上组件往返不可靠）
  doEdit(op) {
    if (op === "D") {
      // del 只清空文本内容，拼音不管
      this.before = ""
      this.after = ""
    } else if (op === "left") {
      // 左移：将 before 最后一个字搬到 after 的第一个字
      if (this.before.length > 0) {
        this.after = this.before.charAt(this.before.length - 1) + this.after
        this.before = this.before.slice(0, this.before.length - 1)
      }
    } else if (op === "right") {
      // 右移：将 after 的第一个字搬到 before 的最后一个字
      if (this.after.length > 0) {
        this.before = this.before + this.after.charAt(0)
        this.after = this.after.slice(1)
      }
    }
  },

  onShow() {
    this.time = global.getTime()
  },

  async save() {
    await settings.setTmp(this.before + this.after)
    await settings.setTmpSaved()
    router.back()
  },

  routeBack() {
    // 取消返回：清除保存标记，接收方不修改任何字段
    settings.clearTmpSaved()
    router.back()
  }
}
</script>

<style>
@import "../../common/app.css";

.container {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.line {
  display: flex;
  flex-direction: column;
  justify-content: left;
  width: 90%;
}

.input-line {
  height: 48px;
  width: 100%;
  background-color: #262626;
  border: 3px solid rgba(255, 255, 255, 0.06);
  border-radius: 100%;
  margin-top: 4px;
}

.input-text {
  lines: 1;
  font-size: 28px;
  color: white;
  font-weight: bold;
  flex-shrink: 0;
}

/* 光标行：三个 text 并排，光标独立着色 */
.input-row {
  flex-direction: row;
  align-items: center;
  height: 100%;
  padding: 0 12px;
}

.cursor {
  color: #0b5cd5;
  font-size: 28px;
  font-weight: bold;
  lines: 1;
  flex-shrink: 0;
}

/* 编辑行：输入框与键盘之间，删除/光标左移/光标右移 三个胶囊按钮水平居中 */
.edit-row {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
  margin-bottom: 6px;
}

.editbtn {
  width: 82px;
  height: 58px;
  margin: 0 3px;
}

.padding {
  height: 75px;
}

@media (device-type: band) and (shape: rect) {
  .line {
    width: 83%;
  }

  .padding {
    height: 75px;
  }
}

@media (device-type: watch) and (shape: rect) {
  .line {
    width: 75%;
  }

  .padding {
    height: 45px;
  }
}
</style>
